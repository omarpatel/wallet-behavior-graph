# Copy to .env.local. `pnpm keygen` fills the key/secret block for you.

# --- database (libSQL: local file or Turso URL) ---
DATABASE_URL=file:./data/wbg.db
DATABASE_AUTH_TOKEN=

# --- mainnet wallet data ---
# Strongly recommended: active trading wallets are flooded with copy-bot spam; public RPC only reaches the newest few hundred txs.
HELIUS_API_KEY=
DATA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_WEBHOOK_AUTH=
JUPITER_API_KEY=
BACKFILL_MAX_TXS=1500
# Parallel backfills in the worker.
BACKFILL_CONCURRENCY=3
# Brains in the live tier (Helius webhook, real-time alerts); the rest are reconciled every 6 h.
LIVE_TRACKED_MAX=80

# --- seats (Metaplex Core) ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
MINT_AUTHORITY_SECRET=
MINT_AUTHORITY_PUBKEY=
MARKET_DELEGATE_SECRET=
MARKET_DELEGATE_PUBKEY=
TREASURY_SECRET=
TREASURY_PUBKEY=
ASSET_SEED_SECRET=
MARKET_FEE_BPS=250

# --- app ---
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=
# Brain pfp cache (relative to the working directory; use a persistent volume in production).
AVATARS_DIR=data/avatars
ADMIN_WALLETS=
BLOCKED_COUNTRIES=GB,CU,IR,KP,SY

# --- AI: Anthropic first; OpenAI takes over (per process, Anthropic re-probed every 30 min) on billing/auth/outage errors ---
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
OPENAI_API_KEY=
AI_OPENAI_MODEL_FAST=gpt-5.4-mini
AI_OPENAI_MODEL_SMART=gpt-5.5
# Hourly cap on alert-explanation model calls; live-tier, swarm and larger trades first, the rest stay unexplained.
AI_MAX_EXPLANATIONS_PER_HOUR=300

# --- brain agents (custodial, mainnet; src/server/agents) ---
# 32 bytes base64/hex sealing every agent wallet key (pnpm keygen adds it). Never rotate in place; back it up.
AGENT_MASTER_KEY=
# Global kill switch: false = the runner places no orders at all.
AGENTS_ENABLED=true
# Real-funds trading; paper agents are unaffected.
AGENTS_LIVE_ENABLED=false
# Net deposits above this per agent are flagged and halt the agent.
AGENT_MAX_DEPOSIT_SOL=5
# LLM entry-judge calls per agent per hour (0 = rules only).
AGENT_LLM_CALLS_PER_HOUR=20
# Mainnet RPC for agent wallets; default Helius mainnet (HELIUS_API_KEY), else DATA_RPC_URL.
AGENT_RPC_URL=
# Jupiter swap API base; default api.jup.ag/swap/v1 with JUPITER_API_KEY, else lite-api.jup.ag/swap/v1.
JUPITER_SWAP_API=
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# --- Brain Picks (src/server/picks; run inside the agents runner, paper-tracked, never place orders) ---
PICKS_ENABLED=true
# New picks per brain per rolling hour.
PICKS_MAX_PER_BRAIN_HOUR=6
# LLM one-liner calls per hour across all brains (0 = deterministic rules only).
PICKS_LLM_CALLS_PER_HOUR=30

# --- X (claimed brains only; official API) ---
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
